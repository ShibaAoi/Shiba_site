---
import works from "../data/works.json";
---

<section id="works" class="page-animate">
  <h2>Works</h2>

  <div class="works-grid">
    {
      works.map((work) => (
        <article class="card">
          <img src={work.image} alt={work.title} />

          <div class="card-body">
            <h3>{work.title}</h3>

            <div class="card-details">
              <p>{work.description}</p>

              <p class="tech">{work.tech}</p>
            </div>

            <a href={work.github}>
              GitHubを見る
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
.works-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 15px;
  max-width: 780px;
}

.card {
  display: grid;
  grid-template-columns: 126px 1fr;
  gap: 18px;
  align-items: center;
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 8px;
  padding: 15px;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(10px);
  transition: 0.25s ease;
}

.card:hover {
  transform: translateY(-3px);
  box-shadow: 0 7px 16px rgba(0, 0, 0, 0.1);
}

.card img {
  width: 126px;
  height: 96px;
  object-fit: contain;
  border-radius: 6px;
}

.card h3 {
  font-size: 19px;
  line-height: 1.25;
  margin: 0 0 5px;
}

.card p {
  font-size: 15px;
  line-height: 1.35;
  margin: 3px 0;
}

.card .tech {
  color: #666;
}

.card-details {
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.card-details:hover {
  transform: translateY(-2px);
  opacity: 0.82;
}

.card a {
  margin-top: 8px;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 15px;
}

@media (max-width: 480px) {
  .works-grid {
    max-width: none;
  }

  .card {
    grid-template-columns: 108px 1fr;
    gap: 15px;
  }

  .card img {
    width: 108px;
    height: 84px;
  }
}
</style>
