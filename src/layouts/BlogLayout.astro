---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
const title = frontmatter.articleTitle ?? frontmatter.title;
const date = frontmatter.date;
---

<BaseLayout title={`${title} | SHIBA Portfolio`}>
  <article class="blog-entry page-animate">
    {date && <p class="blog-date">{date}</p>}
    <h2>{title}</h2>

    <div class="blog-body">
      <slot />
    </div>

    <a class="back-link" href="/">Homeへ戻る</a>
  </article>
</BaseLayout>

<style>
.blog-entry {
  max-width: 1000px;
  margin: 0 auto;
  padding: 80px 20px;
}

.blog-date {
  margin-bottom: 6px;
  color: #666;
  font-size: 13px;
}

.blog-body {
  color: #333;
}

.blog-body :global(p) {
  margin-bottom: 16px;
}

.blog-body :global(h2),
.blog-body :global(h3) {
  margin-top: 28px;
}

.blog-body :global(ul),
.blog-body :global(ol) {
  margin: 0 0 16px 22px;
}

.blog-body :global(strong) {
  color: #111;
}

.back-link {
  display: inline-block;
  margin-top: 24px;
  padding: 8px 14px;
  border-radius: 8px;
  background: #111;
  color: white;
  text-decoration: none;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.back-link:hover {
  opacity: 0.8;
  transform: translateY(-2px);
}

@media (max-width: 768px) {
  .blog-entry {
    padding: 60px 20px;
  }
}
</style>
