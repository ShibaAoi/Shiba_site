---
const friends = [
  {
    name: "どら",
    profile: "ポテトの画像を貼ることを強いられている人。このサイトの6割はここからパクリスペクトされています。",
    url: "https://natamoko.jp/",
    icon: "/images/dora_site.webp"
  },
];
---

<section id="friends" class="page-animate">
  <h2>Friends</h2>

  <div class="friends-grid">
    {
      friends.map((friend) => (
        <a class="friend-card" href={friend.url}>
          <img src={friend.icon} alt={`${friend.name} icon`} />

          <div>
            <h3>{friend.name}</h3>
            <p>{friend.profile}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
.friends-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  max-width: 780px;
}

.friend-card {
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 96px;
  padding: 16px;
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.78);
  color: #222;
  text-decoration: none;
  backdrop-filter: blur(10px);
  box-shadow: 0 7px 16px rgba(0, 0, 0, 0.08);
  transition: transform 0.25s ease, box-shadow 0.25s ease, opacity 0.2s ease;
}

.friend-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.14);
  opacity: 0.92;
}

.friend-card img {
  width: 56px;
  height: 56px;
  flex: 0 0 auto;
  object-fit: cover;
  border-radius: 50%;
}

.friend-card h3 {
  margin: 0 0 4px;
  font-size: 16px;
  line-height: 1.3;
}

.friend-card p {
  margin: 0;
  color: #555;
  font-size: 13px;
  line-height: 1.4;
}

</style>
