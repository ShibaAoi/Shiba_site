---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import { blogPosts } from "../data/blogPosts";
---

<BaseLayout>
  <Hero />

  <section class="home-blog page-animate">
    <h2>ブログ</h2>

    <div class="blog-list">
      {
        blogPosts.map((post) => (
          <a class="blog-card" href={`/blog/${post.id}/`}>
            <p class="blog-date">{post.date}</p>
            <h3>{post.articleTitle}</h3>
            <p>{post.cardHeading}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
.home-blog {
  padding-top: 20px;
}

.blog-list {
  display: grid;
  gap: 16px;
  max-width: 780px;
}

.blog-card {
  display: block;
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 8px;
  padding: 20px;
  background: rgba(255, 255, 255, 0.78);
  color: #222;
  text-decoration: none;
  backdrop-filter: blur(10px);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.blog-card:hover {
  color: #0066cc;
  text-decoration: none;
  transform: translateY(-4px);
  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.1);
}

.blog-card:hover * {
  color: inherit;
  text-decoration: none;
}

.blog-date {
  margin-bottom: 6px;
  color: #666;
  font-size: 13px;
}

.blog-card h3 {
  margin-bottom: 8px;
  font-size: 18px;
}

.blog-card p:last-child {
  margin-bottom: 0;
}
</style>
